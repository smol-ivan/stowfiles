(defcfg
  process-unmapped-keys   yes
  concurrent-tap-hold     yes
  allow-hardware-repeat   no
)

(defsrc
  esc     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv     1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab     q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps    a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft       z    x    c    v    b    n    m    ,    .    /    rsft
  lctl    lmet lalt           spc            ralt rmet menu rctl
)

(defalias
  capsw (tap-hold 200 200 esc lctl)

  to-qwty (layer-switch qwerty)
  to-col  (layer-switch colemak-dh-wide)
  tap_symbols (tap-hold-press 140 180 spc (layer-while-held symbols))
  bang     S-1      ;; !
  amp      S-7      ;; &
  mul      S-8      ;; *
  lp       S-9      ;; (
  rp       S-0      ;; )
  lb       [        ;; [
  rb       ]        ;; ]
  lc       S-[      ;; {
  rc       S-]      ;; }
  lt       S-,      ;; <
  gt       S-.      ;; >
  eq       =        ;; =
  add      S-=      ;; +
  sub      -        ;; -
  bsl      S-\      ;; |
  sym_exit @to-qwty
)

(deflayer colemak-dh-wide
  esc     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv      1    2    3    4    5    6    =    7    8    9    0    -    bspc
  tab      q    w    f    p    b    [    j    l    u    y    ;    '    \
  @capsw     a    r    s    t    g    ]    m    n    e    i    o    ret
  lsft        x    c    d    v    z    /    k    h    ,    .    rsft
  lctl     lmet lalt           @tap_symbols             ralt rmet _    @to-qwty
)

(include "../ansi-symbols-layer.kbd")

(deflayer qwerty
  esc     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv      1    2    3    4    5    6    =    7    8    9    0    -    bspc
  tab     q    w    e    r    t    y    u    i    o    p    [    ]    \
  @capsw  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft       z    x    c    v    b    n    m    ,    .    /    rsft
  lctl    lmet lalt           spc            ralt rmet _ @to-col
)
